---
secrets:
  wireguard_private_key:
    file: "{{ qbittorrent_gluetun_secret_folder }}/wireguard_private_key"

services:
  gluetun:
    image: "{{ qbittorrent_gluetun_image }}"
    container_name: qbittorrent-gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      TZ: Europe/Berlin
      VPN_SERVICE_PROVIDER: protonvpn
      VPN_TYPE: wireguard
      SERVER_COUNTRIES: "{{ qbittorrent_vpn_server_countries }}"
      PORT_FORWARD_ONLY: "on"
      VPN_PORT_FORWARDING: "on"
      VPN_PORT_FORWARDING_STATUS_FILE: /gluetun/forwarded_port
      VPN_PORT_FORWARDING_UP_COMMAND: >-
        /bin/sh /gluetun/update-qbittorrent-port.sh
        {{ '{{PORT}}' }} {{ '{{VPN_INTERFACE}}' }}
      VPN_PORT_FORWARDING_DOWN_COMMAND: >-
        /bin/sh /gluetun/update-qbittorrent-port.sh 0 lo
    ports:
      - "{{ qbittorrent_http_port }}:{{ qbittorrent_http_port }}/tcp"
    volumes:
      - "{{ qbittorrent_gluetun_config_folder }}:/gluetun"
    secrets:
      - wireguard_private_key

  qbittorrent:
    image: "{{ qbittorrent_image }}"
    container_name: qbittorrent
    restart: unless-stopped
    stop_grace_period: 30m
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_started
    environment:
      PUID: "{{ uid }}"
      PGID: "{{ qbittorrent_gid }}"
      TZ: Europe/Berlin
      WEBUI_PORT: "{{ qbittorrent_http_port }}"
      TORRENTING_PORT: "{{ qbittorrent_torrenting_port }}"
      DOCKER_MODS: "{{ qbittorrent_vuetorrent_mod }}"
    volumes:
      - "{{ qbittorrent_config_folder }}:/config"
      - "{{ qbittorrent_data_folder }}:/data"
    labels:
      homepage.group: "{{ services.qbittorrent.group }}"
      homepage.name: "{{ services.qbittorrent.name }}"
      homepage.href: "https://{{ services.qbittorrent.domain }}"
      homepage.icon: "{{ services.qbittorrent.icon }}"
      homepage.server: "{{ inventory_hostname }}"
      homepage.container: qbittorrent

  port-sync:
    image: "{{ qbittorrent_port_sync_image }}"
    container_name: qbittorrent-port-sync
    restart: unless-stopped
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_started
      qbittorrent:
        condition: service_started
    command:
      - /bin/sh
      - -c
      - >-
        while true; do
          /bin/sh /gluetun/update-qbittorrent-port.sh >/dev/null 2>&1 || true;
          sleep 15;
        done
    volumes:
      - "{{ qbittorrent_gluetun_config_folder }}:/gluetun:ro"

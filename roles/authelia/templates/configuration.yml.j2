---
theme: auto
default_2fa_method: webauthn

server:
  address: tcp://0.0.0.0:9091

log:
  level: info
  format: text

identity_validation:
  reset_password: {}

authentication_backend:
  password_change:
    disable: true
  password_reset:
    disable: true
  file:
    path: /config/users_database.yml
    watch: true
    search:
      email: true
      case_insensitive: true

access_control:
  default_policy: deny
  rules:
{% for service_name, props in services.items() %}
{% if props.auth is defined and props.auth.provider | default('') == 'authelia' %}
    - domain: "{{ props.domain }}"
      policy: "{{ props.auth.policy | default('one_factor') }}"
{% if props.auth.groups is defined %}
      subject:
{% for group in props.auth.groups %}
        - "group:{{ group }}"
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}

session:
  cookies:
    - domain: "{{ authelia_session_domain }}"
      authelia_url: "https://{{ authelia_domain }}"
      default_redirection_url: "{{ authelia_default_redirection_url }}"
      same_site: lax
      inactivity: 15m
      expiration: 8h
      remember_me: 1M

regulation:
  max_retries: 5
  find_time: 2m
  ban_time: 10m

storage:
  local:
    path: /config/db.sqlite3

identity_providers:
  oidc:
    jwks:
      - key: {% raw %}{{ secret "/config/secrets/OIDC_ISSUER_PRIVATE_KEY" | mindent 10 "|" | msquote }}{% endraw %}

    clients:
      - client_id: "{{ authelia_oidc_linkding_client_id }}"
        client_name: Linkding
        client_secret: "{{ authelia_oidc_linkding_client_secret_hash | trim }}"
        public: false
        authorization_policy: two_factor
        require_pkce: false
        pkce_challenge_method: ""
        redirect_uris:
          - "https://{{ services.linkding.domain }}/oidc/callback/"
        scopes:
          - openid
          - email
          - profile
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
        token_endpoint_auth_method: client_secret_post
      - client_id: "{{ authelia_oidc_beszel_client_id }}"
        client_name: Beszel
        client_secret: "{{ authelia_oidc_beszel_client_secret_hash | trim }}"
        public: false
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - "https://{{ services.beszel.domain }}/api/oauth2-redirect"
        scopes:
          - openid
          - email
          - profile
        response_types:
          - code
        grant_types:
          - authorization_code
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
        token_endpoint_auth_method: client_secret_basic

notifier:
  disable_startup_check: false
  smtp:
    address: "{{ authelia_smtp_address }}"
    username: "{{ authelia_smtp_username }}"
    sender: "{{ authelia_smtp_sender }}"
    identifier: "{{ authelia_smtp_identifier }}"
    subject: "[Kirelabs Auth] {title}"
    startup_check_address: "{{ authelia_smtp_startup_check_address }}"
    tls:
      server_name: smtp-relay.brevo.com
      skip_verify: false
      minimum_version: TLS1.2

totp:
  disable: true

webauthn:
  enable_passkey_login: true
  experimental_enable_passkey_uv_two_factors: true
  display_name: Kirelabs Homelab
  selection_criteria:
    discoverability: required
    user_verification: required

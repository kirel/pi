---
services:
  sonarr:
    image: "{{ sonarr_image }}"
    container_name: sonarr
    restart: unless-stopped
    environment:
      PUID: "{{ uid }}"
      PGID: "{{ qbittorrent_gid }}"
      TZ: Europe/Berlin
    ports:
      - "{{ sonarr_http_port }}:8989"
    volumes:
      - "{{ sonarr_config_folder }}:/config"
      - "{{ qbittorrent_data_folder }}:/data"
    labels:
{% for label_key, label_value in (services['sonarr'] | autokuma_labels('sonarr', 'sonarr')).items() %}
      {{ label_key }}: {{ label_value | to_json }}
{% endfor %}
      homepage.group: "{{ services.sonarr.group }}"
      homepage.name: "{{ services.sonarr.name }}"
      homepage.href: "https://{{ services.sonarr.domain }}"
      homepage.icon: "{{ services.sonarr.icon }}"
      homepage.server: "{{ inventory_hostname }}"
      homepage.container: sonarr
{% if sonarr_include_recyclarr | default(true) %}

  recyclarr:
    image: "{{ sonarr_recyclarr_image }}"
    container_name: recyclarr-sonarr
    restart: unless-stopped
    user: "{{ uid }}:{{ qbittorrent_gid }}"
    depends_on:
      - sonarr
    environment:
      TZ: Europe/Berlin
      CRON_SCHEDULE: "{{ sonarr_recyclarr_cron_schedule }}"
    volumes:
      - "{{ sonarr_recyclarr_config_folder }}:/config"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
{% endif %}

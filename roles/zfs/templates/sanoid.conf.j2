# Sanoid Configuration
# Generated by Ansible - do not edit manually

{% for dataset in zfs_datasets %}
[{{ dataset.name }}]
  use_template = production
  recursive = no

{% endfor %}

# BEGIN ANSIBLE ADDITIONAL SNAPSHOT DATASETS
{% for dataset in zfs_additional_snapshot_datasets | default([]) %}
{% if dataset not in (zfs_datasets | map(attribute='name') | list) %}
[{{ dataset }}]
  use_template = production
  recursive = no

{% endif %}
{% endfor %}
# END ANSIBLE ADDITIONAL SNAPSHOT DATASETS

[template_production]
  frequently = 0
  hourly = {{ zfs_snapshot_schedule.hourly }}
  daily = {{ zfs_snapshot_schedule.daily }}
  weekly = {{ zfs_snapshot_schedule.weekly }}
  monthly = {{ zfs_snapshot_schedule.monthly }}
  yearly = 0
  autosnap = yes
  autoprune = yes

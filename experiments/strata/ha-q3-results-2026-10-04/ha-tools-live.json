    {
      "name": "script__play_music",
      "description": "Play music with Music Assistant from a voice request. Use this tool for German or English requests to play songs, artists, albums, playlists, radio, genres, moods, children's music, sleep music, or generic music. The required arguments are media_type, media_id, media_description, artist, album, and shuffle. Keep media_id as the best natural Music Assistant search query. Use empty strings for unknown artist or album. If the user only says \"Spiel Musik\" or \"Mach Musik an\", use media_id \"500 Random Tracks\", media_type \"track\", and shuffle true. Prefer area for room names; if no area/player is known, the default player Wohnzimmer is used.. Aliases: ['Spiel Musik']",
      "inputSchema": {
        "type": "object",
        "properties": {
          "media_type": {
            "type": "string",
            "enum": [
              "track",
              "album",
              "artist",
              "playlist",
              "radio"
            ],
            "description": "Return exactly one of: track, album, artist, playlist, radio.\n\nChoose the type from the user's intent:\n- track: a specific song, several songs, a genre/mood request, or a generic request such as \"play music\".\n- album: only if the user clearly asks for an album.\n- artist: only if the user mainly asks for an artist/band.\n- playlist: only if the user asks for a playlist or a known named mix/list.\n- radio: only for radio stations or live radio.\n\nIf unsure, use track. Do not invent a more specific type."
          },
          "artist": {
            "type": "string",
            "description": "Artist named by the user, or the artist of a specific requested track if clearly stated.\nUse an empty string if unknown, irrelevant, generic, or multiple artists are requested."
          },
          "album": {
            "type": "string",
            "description": "Album named by the user, or the album of a specific requested track if clearly stated.\nUse an empty string if unknown, irrelevant, generic, or multiple albums are requested."
          },
          "media_id": {
            "type": "string",
            "description": "Always provide the best Music Assistant search query.\n\nPrefer the natural title/name the user actually asked for. Do not add extra words like \"playlist\" unless they are part of the real name.\n\nExamples:\n- \"Spiel Queen\" -> Queen\n- \"Spiel Bohemian Rhapsody von Queen\" -> Bohemian Rhapsody\n- \"Spiel das Album A Night at the Opera\" -> A Night at the Opera\n- \"Spiel Musik\" / \"Mach Musik an\" -> 500 Random Tracks\n- \"Spiel Kinderlieder\" -> Kinderlieder\n- \"Spiel Schlafmusik\" -> Schlafmusik\n\nFor multiple specific tracks, separate titles with semicolons."
          },
          "media_description": {
            "type": "string",
            "description": "Short natural-language description of only the music request, without room/player words.\nExamples:\n- \"Spiel Queen im Wohnzimmer\" -> Queen\n- \"Spiel ruhige Musik im Schlafzimmer\" -> ruhige Musik\n- \"Mach Musik an\" -> Musik"
          },
          "area": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Use the requested Home Assistant area if the user names a room.\nIf no room/player is mentioned, use the area where the request came from when available.\nIf the area cannot be determined, omit this parameter so the default player is used.\nDo not guess rooms."
          },
          "media_player": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "entity_id"
            },
            "description": "Only use this when the user explicitly names a Music Assistant media player/entity.\nUsually prefer area over media_player for room names such as Wohnzimmer, Küche, Bad, Schlafzimmer.\nDo not use both area and media_player unless the user clearly mentioned both."
          },
          "shuffle": {
            "type": "boolean",
            "description": "Return true only if the user asks for shuffle/random/mix/zufällig or makes a generic request like \"spiel Musik\".\nReturn false for specific songs, albums, artists, playlists, or radio unless shuffle/random is explicitly requested."
          }
        }
      }
    },
